# .npmignore is a DENYLIST, not an allowlist. Ship ONLY the wrapper surface
# (bin/, README.npm.md, package.json) by ignoring everything else in the repo.
# The Python package itself is distributed via GitHub release wheels
# (downloaded by bin/install.js at install time), so source, tests, CI, docs,
# and the full README must never land in the npm tarball.

# Ignore everything by default, then re-allow only the wrapper files.
*

# Re-allow the npm wrapper surface.
!bin/
!bin/**
!README.npm.md
!package.json
!LICENSE

# But keep these out even if matched above.
node_modules/
